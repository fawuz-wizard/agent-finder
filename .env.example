# Agent Finder — environment variables
# Copy to .env (root, used by docker compose and the API) and to apps/web/.env.local (web).
# Never commit real values. The web app must only ever receive VITE_* variables.

# ---------- API (apps/api) ----------
APP_ENV=development                      # development | staging | production
APP_NAME=agent-finder-api
LOG_LEVEL=INFO
# Pilot default: one SQLite file next to the API — no database server to install.
# For Postgres/Supabase use: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite+aiosqlite:///./agentfinder.db
# fake = "Orange (demo)" balances for the dealer's audited financial view; none = no operator link.
OPERATOR_ADAPTER=fake
SEED_ON_START=true
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# demo  = fixed demo PIN login for seeded demo accounts (investor build; clearly labelled in the UI)
# otp   = real phone OTP through Supabase Auth (requires an SMS provider that reaches Sierra Leone numbers)
AUTH_MODE=demo
# Only used when AUTH_MODE=otp. The service-role key NEVER reaches the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Timezone used for night mode and freshness display decisions (server-side).
APP_TIMEZONE=Africa/Freetown

# ---------- Web (apps/web/.env.local) ----------
VITE_API_BASE_URL=http://localhost:8000
# mock = in-browser demo data (no server needed); live = talk to the API above.
VITE_API_MODE=mock
# Browser key restricted by HTTP referrer to the Maps JavaScript API only. See docs/google-cloud-setup.md.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID with Advanced Markers enabled (Google Cloud → Map Management).
VITE_GOOGLE_MAPS_MAP_ID=
VITE_AUTH_MODE=demo

# ---------- Database container (infra/docker-compose.yml) ----------
POSTGRES_USER=agentfinder
POSTGRES_PASSWORD=agentfinder
POSTGRES_DB=agentfinder
