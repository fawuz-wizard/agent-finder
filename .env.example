# Agent Finder — environment variables
# Copy to .env (root, used by docker compose and the API) and to apps/web/.env.local (web).
# Never commit real values. The web app must only ever receive VITE_* variables.

# ---------- API (apps/api) ----------
APP_ENV=development                      # development | staging | production
APP_NAME=agent-finder-api
LOG_LEVEL=INFO
# Pilot default: one SQLite file next to the API — no database server to install.
# For PostgreSQL use: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite+aiosqlite:///./agentfinder.db
# fake = "Orange (demo)" balances for the dealer's audited financial view; none = no operator link.
OPERATOR_ADAPTER=fake
# Operator activity feed: when true, the host system's position (from the adapter) is the truth
# behind every phrase and agents are never asked to refresh capacity. false for the pilot with
# real agents (the fake adapter's figures would be nonsense for them); true for the demo build.
OPERATOR_FEED=false
# week = the 7-day rule: active days, the exact transaction, customer reports; never 100, 95 at
# best; agents and aggregators read it in words. activity = the older success probability (fit
# with: python -m scripts.train_ranker); rules = the fixed order.
RANKER=week
# Error tracking: paste the Sentry DSN to switch it on; empty means off.
SENTRY_DSN=
# Plant the demo dealer, demo agents and PIN 1234 into an EMPTY database at startup.
# Unset: true in development/test, false in production. Never seeds over existing data.
SEED_ON_START=true
# Comma-separated list of browser origins allowed to call the API (the web app's URL).
# Unset: the local dev servers in development; in production the API refuses to start without it.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PIN sign-in. Accounts are issued by the aggregator or the team; nobody signs up.
AUTH_MODE=demo
# Timezone used for night mode and freshness display decisions (server-side).
APP_TIMEZONE=Africa/Freetown

# ---------- Web (apps/web/.env.local) ----------
VITE_API_BASE_URL=http://localhost:8000
# mock = in-browser demo data (no server needed); live = talk to the API above.
VITE_API_MODE=mock
# Demo only: start with the simulated Orange Money feed on (the host shell has a toggle too).
VITE_OPERATOR_FEED=off
# Optional: a Google Maps browser key for the route map. Without it the app uses OpenStreetMap tiles.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_AUTH_MODE=demo

# ---------- Database container (infra/docker-compose.yml) ----------
POSTGRES_USER=agentfinder
POSTGRES_PASSWORD=agentfinder
POSTGRES_DB=agentfinder
