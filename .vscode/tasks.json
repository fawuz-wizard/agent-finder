{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Demo: install",
      "type": "shell",
      "command": "npm install --legacy-peer-deps",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "problemMatcher": []
    },
    {
      "label": "Demo: customer app (5175)",
      "type": "shell",
      "command": "npx vite --port 5175 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/apps/web",
        "env": {
          "VITE_API_MODE": "mock"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Demo: agent and aggregator (5177)",
      "type": "shell",
      "command": "npx vite --port 5177 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/apps/web",
        "env": {
          "VITE_API_MODE": "mock",
          "VITE_APP_SURFACE": "agent"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Demo: run both",
      "dependsOn": [
        "Demo: customer app (5175)",
        "Demo: agent and aggregator (5177)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Live: install",
      "detail": "First time only: the API's Python packages (exact versions) and the web app's packages.",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements.lock && .venv/bin/pip install --no-deps -e . && cd ../web && npm install --legacy-peer-deps",
      "windows": {
        "command": "py -3.12 -m venv .venv; if (-not $?) { python -m venv .venv }; if ($?) { .venv\\Scripts\\python -m pip install -r requirements.lock }; if ($?) { .venv\\Scripts\\python -m pip install --no-deps -e . }; if ($?) { cd ..\\web; npm install --legacy-peer-deps }",
        "options": {
          "cwd": "${workspaceFolder}/apps/api",
          "shell": {
            "executable": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command"
            ]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "problemMatcher": []
    },
    {
      "label": "Live: API (8000)",
      "detail": "The real API on a local demo database (apps/api/meeting-demo.db) with the demo accounts.",
      "type": "shell",
      "command": ".venv/bin/python -m uvicorn app.main:app --port 8000",
      "windows": {
        "command": ".venv\\Scripts\\python -m uvicorn app.main:app --port 8000",
        "options": {
          "cwd": "${workspaceFolder}/apps/api",
          "env": {
            "APP_ENV": "development",
            "SEED_ON_START": "true",
            "OPERATOR_ADAPTER": "fake",
            "DATABASE_URL": "sqlite+aiosqlite:///./meeting-demo.db",
            "CORS_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:5181"
          },
          "shell": {
            "executable": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command"
            ]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}/apps/api",
        "env": {
          "APP_ENV": "development",
          "SEED_ON_START": "true",
          "OPERATOR_ADAPTER": "fake",
          "DATABASE_URL": "sqlite+aiosqlite:///./meeting-demo.db",
          "CORS_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:5181"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Live: customer app (5173)",
      "type": "shell",
      "command": "npx vite --port 5173 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/apps/web",
        "env": {
          "VITE_API_MODE": "live",
          "VITE_API_BASE_URL": "http://localhost:8000"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Live: agent and aggregator (5174)",
      "type": "shell",
      "command": "npx vite --port 5174 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/apps/web",
        "env": {
          "VITE_API_MODE": "live",
          "VITE_API_BASE_URL": "http://localhost:8000",
          "VITE_APP_SURFACE": "agent"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Live: Orange national console (5181)",
      "type": "shell",
      "command": "npx vite --port 5181 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/apps/web",
        "env": {
          "VITE_API_MODE": "live",
          "VITE_API_BASE_URL": "http://localhost:8000",
          "VITE_APP_SURFACE": "national"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Live: run all",
      "detail": "The API and the three apps, sharing one database.",
      "dependsOn": [
        "Live: API (8000)",
        "Live: customer app (5173)",
        "Live: agent and aggregator (5174)",
        "Live: Orange national console (5181)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
