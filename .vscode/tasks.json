{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Demo: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "problemMatcher": []
    },
    {
      "label": "Demo: customer app (5175)",
      "type": "shell",
      "command": "npx vite --port 5175 --strictPort",
      "options": { "cwd": "${workspaceFolder}/apps/web", "env": { "VITE_API_MODE": "mock" } },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Demo: agent and aggregator (5177)",
      "type": "shell",
      "command": "npx vite --port 5177 --strictPort",
      "options": { "cwd": "${workspaceFolder}/apps/web", "env": { "VITE_API_MODE": "mock", "VITE_APP_SURFACE": "agent" } },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Demo: run both",
      "dependsOn": ["Demo: customer app (5175)", "Demo: agent and aggregator (5177)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
