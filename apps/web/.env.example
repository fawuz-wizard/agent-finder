VITE_API_BASE_URL=http://localhost:8000
# mock = in-browser demo data (no server needed); live = talk to the API above.
VITE_API_MODE=mock
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# Error tracking: the Sentry DSN for the web apps; empty means off. The demo never reports.
VITE_SENTRY_DSN=
# Which environment the errors are filed under in Sentry: production or staging, the same names
# as the server's APP_ENV. Empty means the build's mode (production for a built app).
VITE_APP_ENV=
VITE_AUTH_MODE=demo
# Map pictures for the pilot (TomTom Map Display API). Empty means OpenStreetMap, for the demo only.
# Restrict the key to your domains in the TomTom developer portal; it is visible in the browser.
VITE_TOMTOM_API_KEY=
